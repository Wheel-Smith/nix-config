# Copy to .env. Non-secret settings only: passwords and API keys live in the
# macOS Keychain (`bin/ctf secrets`).
VPN_SERVER=vpn.example.org
VPN_PORT=443
VPN_USER=you
# anyconnect (Cisco), gp (GlobalProtect), nc, pulse, f5, fortinet, array
VPN_PROTOCOL=anyconnect
# Extra openconnect flags, e.g. --servercert pin-sha256:... or --authgroup=X
VPN_EXTRA_ARGS=
# Domains resolved through the VPN's DNS ("*" = everything, empty = none).
CTF_DNS_DOMAINS=
