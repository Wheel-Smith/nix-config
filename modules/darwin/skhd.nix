{ config, lib, pkgs, isWork, ... }:
# skhd: a hotkey daemon whose only job here is forwarding Option+<letter> to
# OmniWM for workspaces above nine (see letter-workspaces.nix for why skhd and
# not OmniWM's own 0.7.4+ hotkeys). The letters and
# their apps live in modules/shared/letter-workspaces.nix.
#
# skhd needs the Accessibility permission. The grant is tied to the binary's
# /nix/store path, so it only needs renewing when skhd itself changes, which
# is rare.
let
  letterWorkspaces = import ../shared/letter-workspaces.nix { inherit lib isWork; };

  # Absolute store path: the launchd agent's PATH does not include the
  # home-manager profile where omniwmctl is installed. pkgs.omniwm is the same
  # overlaid derivation home-manager installs (useGlobalPkgs).
  omniwmctl = "${pkgs.omniwm}/bin/omniwmctl";

  # Send the current workspace, windows and all, to the other monitor,
  # wherever it is. omniwmctl only moves a workspace in a direction, so the
  # direction comes from the displays' frames: from the centre of the
  # workspace's display to the centre of the next display in OmniWM's list
  # (with three or more, repeated presses cycle through them), along whichever
  # axis is further apart. OmniWM's frames use macOS's y-up coordinates. If
  # that direction is still refused (odd diagonal layouts), try the rest.
  # Whatever was showing on the target monitor stays parked there. --force
  # because every workspace is pinned to a monitor in settings.toml, and a
  # pinned workspace otherwise refuses to move (workspace_assignment_conflict).
  otherMonitorDirection = pkgs.writeText "other-monitor-direction.jq" ''
    [.result.payload.displays[]
      | {id, x: (.frame.x + .frame.width / 2), y: (.frame.y + .frame.height / 2)}] as $d
    | ($d | map(.id) | index($cur)) as $i
    | select($i != null and ($d | length) > 1)
    | $d[$i] as $a | $d[($i + 1) % ($d | length)] as $b
    | ($b.x - $a.x) as $dx | ($b.y - $a.y) as $dy
    | if ($dx | fabs) >= ($dy | fabs)
      then (if $dx > 0 then "right" else "left" end)
      else (if $dy > 0 then "up" else "down" end) end
  '';

  toggleMonitor = pkgs.writeShellScript "omniwm-toggle-monitor" ''
    ctl=${omniwmctl}
    jq=${lib.getExe pkgs.jq}
    active=$($ctl query active-workspace --json) || exit 1
    ws=$(printf '%s' "$active" | $jq -r '.result.payload.workspace.number // empty')
    cur=$(printf '%s' "$active" | $jq -r '.result.payload.display.id // empty')
    [ -n "$ws" ] && [ -n "$cur" ] || exit 1
    dir=$($ctl query displays --json | $jq -r --arg cur "$cur" -f ${otherMonitorDirection}) || exit 1
    [ -n "$dir" ] || exit 1
    for d in "$dir" right left up down; do
      $ctl workspace move-to-monitor "$ws" "$d" --force >/dev/null 2>&1 && exit 0
    done
    exit 1
  '';

  binding = ws: ''
    ${ws.skhd.switch} : ${omniwmctl} command switch-workspace ${toString ws.number}
    ${ws.skhd.move} : ${omniwmctl} command move-to-workspace ${toString ws.number}
  '';
in
{
  services.skhd = {
    enable = true;
    skhdConfig = ''
      # Generated by modules/darwin/skhd.nix; edit letter-workspaces.nix instead.
      ${lib.concatMapStrings binding letterWorkspaces}
      # Workspace to the other monitor (owned here, not by OmniWM, see above).
      shift + alt - tab : ${toggleMonitor}
    '';
  };

  # skhd runs each command with $SHELL. /bin/sh keeps a keypress from starting
  # zsh with its startup files. This has to be the environment: the `.shell`
  # config directive exists only in unreleased skhd, and 0.3.9 rejects the
  # whole file over it, silently leaving no hotkeys bound.
  launchd.user.agents.skhd.serviceConfig.EnvironmentVariables.SHELL = "/bin/sh";

  # skhd reads its config once and does not notice when activation swaps the
  # /etc/skhdrc symlink, and the stock agent's arguments never change, so it
  # kept running a stale config: after the OmniWM 0.7.3 -> 0.7.5 bump every
  # letter key called the old omniwmctl, which cannot reach the new OmniWM,
  # and all of them failed silently until a manual restart. Pointing skhd at
  # the config's store path changes the agent whenever the config does, so
  # activation restarts skhd with it.
  launchd.user.agents.skhd.serviceConfig.ProgramArguments = lib.mkForce [
    "${config.services.skhd.package}/bin/skhd"
    "-c"
    "${pkgs.writeText "skhdrc" config.services.skhd.skhdConfig}"
  ];
}
